# Environment variables for the Orano Med Frontend ReactJS project

# API Base URL
VITE_API_BASE_URL=http://localhost:3000/api

# React Query Configuration
# Time in milliseconds that unused/inactive cache data remains in memory (5 minutes)
VITE_REACT_QUERY_STALE_TIME=300000
# Time in milliseconds that cache data remains in memory after being unused (10 minutes)
VITE_REACT_QUERY_CACHE_TIME=600000
# Number of times to retry failed requests
VITE_REACT_QUERY_RETRY=3
# Base retry delay in milliseconds (exponential backoff will be applied)
VITE_REACT_QUERY_RETRY_DELAY=1000
# Maximum retry delay in milliseconds
VITE_REACT_QUERY_MAX_RETRY_DELAY=30000

# Authentication
VITE_AUTH_TOKEN_KEY=authToken
VITE_AUTH_REFRESH_TOKEN_KEY=refreshToken

# Feature Flags
VITE_FEATURE_FLAG_EXPERIMENTAL=true

# Application Metadata
VITE_APP_NAME=OranoMed
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Logging
VITE_LOG_LEVEL=debug

# Other environment variables can be added here as needed