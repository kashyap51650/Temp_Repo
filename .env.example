# Environment variables for the Orano Med Frontend ReactJS project
# Copy this file to .env and fill in the actual values

# API Base URL
VITE_API_BASE_URL=

# Version for API
VITE_API_VERSION=

# React Query Configuration
# Time in milliseconds that unused/inactive cache data remains in memory (5 minutes)
VITE_REACT_QUERY_STALE_TIME=
# Time in milliseconds that cache data remains in memory after being unused (10 minutes)
VITE_REACT_QUERY_CACHE_TIME=
# Number of times to retry failed requests
VITE_REACT_QUERY_RETRY=
# Base retry delay in milliseconds (exponential backoff will be applied)
VITE_REACT_QUERY_RETRY_DELAY=
# Maximum retry delay in milliseconds
VITE_REACT_QUERY_MAX_RETRY_DELAY=

# Authentication
VITE_AUTH_TOKEN_KEY=
VITE_AUTH_REFRESH_TOKEN_KEY=

# Feature Flags
VITE_FEATURE_FLAG_EXPERIMENTAL=

# Application Metadata
VITE_APP_NAME=
VITE_APP_VERSION=
VITE_APP_ENV=

# Logging
VITE_LOG_LEVEL=

# Other environment variables can be added here as needed