# Environment variables for the Orano Med Frontend ReactJS project
# Copy this file to .env and fill in the actual values

# API Base URL
VITE_API_BASE_URL=

# Version for API
VITE_API_VERSION=

# Socket.IO Configuration
VITE_SOCKET_URL=

# Authentication
VITE_AUTH_TOKEN_KEY=
VITE_AUTH_REFRESH_TOKEN_KEY=

# Feature Flags
VITE_FEATURE_FLAG_EXPERIMENTAL=

# Application Metadata
VITE_APP_NAME=
VITE_APP_VERSION=
VITE_APP_ENV=

# Logging
VITE_LOG_LEVEL=

# Sentry DSN
VITE_SENTRY_DSN=

# Other environment variables can be added here as needed